{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "handoff-next-task-v1",
  "title": "관리 세션 → 개발 세션 작업 지시서",
  "description": "관리 세션이 사용자 결정 후 작성. 개발 세션이 작업 시작 시 읽음.",
  "type": "object",
  "required": ["ts", "task_id", "task", "goal", "conditions"],
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{8}_[0-9]{6}$",
      "description": "발행 타임스탬프"
    },
    "task_id": {
      "type": "string",
      "description": "작업 식별자 (report, decision과 연결)",
      "example": "task_002"
    },
    "task": {
      "type": "string",
      "description": "작업 이름 (한 줄)"
    },
    "goal": {
      "type": "string",
      "description": "작업 목표 — 사용자 언어로 기술",
      "example": "로그인 후 대시보드로 이동하도록 화면 흐름 변경"
    },
    "details": {
      "type": "array",
      "items": { "type": "string" },
      "description": "세부 작업 항목"
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "완료 조건 — 이것이 충족되면 report.status = completed",
      "example": ["로그인 후 대시보드 화면이 표시됨", "기존 로그인 기능 정상 동작 유지"]
    },
    "cautions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "주의 사항",
      "example": ["기존 사용자 세션 유지 필수", "모바일 화면 확인 필요"]
    },
    "ref_decision_ts": {
      "type": ["string", "null"],
      "description": "이 지시를 생성한 결정 파일의 ts (추적용)"
    }
  }
}
